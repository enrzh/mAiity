{
  "version": 8,
  "name": "Light z14 (Test)",
  "metadata": {
    "maps:pack": "light-z14",
    "maps:schema": "protomaps-basemap-v4"
  },
  "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://protomaps.github.io/basemaps-assets/sprites/v4/light",
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "pmtiles://https://privatenas.nl/maps/region-z14.pmtiles?v=1",
      "attribution": "<a href=\"https://openstreetmap.org/copyright\">© OpenStreetMap</a> · <a href=\"https://protomaps.com\">Protomaps</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#a5cae8"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#eae7df"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "forest",
            "wood",
            "scrub",
            "grassland",
            "grass"
          ],
          "#d6e6c3",
          [
            "farmland"
          ],
          "#e9e6cf",
          [
            "glacier",
            "snow"
          ],
          "#f4f6f7",
          "rgba(0,0,0,0)"
        ],
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "park",
            "grass",
            "recreation_ground",
            "garden",
            "cemetery",
            "pitch"
          ],
          "#dfeacd",
          [
            "hospital"
          ],
          "#f2e6e4",
          [
            "school",
            "university",
            "college"
          ],
          "#efeade",
          "rgba(0,0,0,0)"
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a5cae8"
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#e4dfd4",
        "fill-outline-color": "#d3cdbf",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          15,
          0.9
        ]
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "highway",
          "major_road",
          "medium_road"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#e0d8c8",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          6,
          1,
          12,
          3,
          16,
          10,
          20,
          34
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "highway"
          ],
          "#fff2cc",
          [
            "major_road",
            "medium_road"
          ],
          "#ffffff",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          6,
          0.4,
          12,
          1.4,
          16,
          6,
          20,
          24
        ]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#9f95b5",
        "line-dasharray": [
          3,
          2
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.6,
          10,
          1.4
        ]
      }
    },
    {
      "id": "places-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          11,
          8,
          14,
          13,
          18
        ],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#3d3d3d",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    }
  ]
}